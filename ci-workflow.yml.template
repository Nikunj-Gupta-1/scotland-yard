name: CI

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

jobs:
  verify:
    name: Lint, Typecheck, Test & Build
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: "npm"

      - name: Install dependencies
        run: npm ci

      - name: Lint packages (enforces strip-types import rules)
        run: npm run lint

      - name: Typecheck all workspaces
        run: npm run typecheck

      - name: Run unit & socket integration tests
        run: npm test

      - name: Build Next.js client production bundle
        run: npm run build:client
