# ==========================================
# Scotland Yard Monorepo - Environment Configuration
# ==========================================
# All variables are OPTIONAL and have sensible zero-configuration defaults.
# No .env file is required to build or run the project.

# --- Client Configuration (packages/client) ---
# Base path if serving under a subpath (e.g. /play). Default: empty (root).
# BASE_PATH=/play

# Override the WebSocket and API server target.
# Default: dynamically resolves to http://${window.location.hostname}:3001
# If proxying everything through Apache on port 80/443 without exposing port 3001, set:
# NEXT_PUBLIC_SERVER_URL=/
# NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Allowed origins for Next.js dev server cross-origin requests (comma-separated).
# Default: dynamically auto-detects all host IPv4 network interfaces
# ALLOWED_DEV_ORIGINS=192.168.1.50,scotlandyard.local

# --- Server Configuration (packages/server) ---
# Port and host binding for the Express + Socket.IO server.
# Defaults: HOST=0.0.0.0, PORT=3001
# PORT=3001
# HOST=0.0.0.0

# CORS Allowed Origins (comma-separated, or omitted for dynamic origin reflection across LAN)
# CORS_ORIGIN=*

# Session reconnection grace period in milliseconds before converting seat to bot (default: 45000 = 45s)
# RECONNECT_GRACE_MS=45000
