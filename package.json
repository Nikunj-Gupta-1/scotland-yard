{
  "name": "scotland-yard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:common": "npm run test --workspace=packages/common",
    "test:server": "npm run test --workspace=packages/server",
    "lint": "eslint packages/ --quiet",
    "typecheck": "tsc --noEmit -p packages/common && tsc --noEmit -p packages/server && tsc --noEmit -p packages/client",
    "build:client": "npm run build --workspace=packages/client",
    "dev:client": "npm run dev --workspace=packages/client",
    "dev:server": "npm run dev --workspace=packages/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "latest",
    "typescript-eslint": "^8.72.0"
  }
}
